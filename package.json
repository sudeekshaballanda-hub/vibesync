{
    "name": "vibesync",
    "version": "2.0.0",
    "private": true,
    "dependencies": {
        "axios": "^1.15.2",
        "concurrently": "^8.2.2",
        "express": "^4.18.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-scripts": "5.0.1",
        "ws": "^8.16.0"
    },
    "scripts": {
        "start": "concurrently --names \"SYNC,REACT\" --prefix-colors \"magenta,cyan\" \"node server.js\" \"react-scripts start\"",
        "server": "node server.js",
        "client": "react-scripts start",
        "build": "react-scripts build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "proxy": "http://localhost:8080"
}
